# Copy the email settings into backend/.env for local use or the backend's
# Environment page on Render. Never put API credentials in frontend variables.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=

# Local frontend address. In production, use:
# https://pe-3-system-deployed-1.onrender.com
PUBLIC_APP_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Existing JWT/database/ML settings must also remain configured separately.
# Keep JWT_SECRET unchanged so sessions and older emailed image links remain valid.

# Optional legacy image-link origin. New risk emails embed the PNG directly.
# PUBLIC_API_URL=https://pe-3-system-deployed.onrender.com
# RISK_ALERT_COOLDOWN_HOURS=168
